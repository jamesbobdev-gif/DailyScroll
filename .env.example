# Copy to .env on your service host. Never put secrets in EXPO_PUBLIC variables.
PUBLIC_ORIGIN=https://your-service.example
COOKIE_SECURE=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
# Used at mobile build time; it contains no secrets.
EXPO_PUBLIC_SERVICE_URL=https://your-service.example

# Optional stable server-side key: 64 hexadecimal characters, stored privately.
TOKEN_ENCRYPTION_KEY=
