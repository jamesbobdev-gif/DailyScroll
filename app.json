{
  "expo": {
    "name": "The Daily Scroll",
    "slug": "the-daily-scroll",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.thedailyscroll.mobile"
    },
    "android": {
      "package": "app.thedailyscroll.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#174737"
      },
      "versionCode": 3
    },
    "scheme": "dailyscroll",
    "plugins": [
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f7f0"
    }
  }
}
