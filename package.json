{
  "name": "daily-scroll",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit",
    "test": "node --test budget.test.mjs server.test.mjs oauth.test.mjs guest.test.mjs connected-feeds.test.mjs public-youtube.test.mjs native-platforms.test.mjs public-previews.test.mjs youtube-feed.test.mjs mirror.test.mjs companion-zip.test.mjs desktop/user-agent.test.mjs chrome-companion.test.mjs client.test.mjs",
    "service": "node server.mjs --testing",
    "service:limited": "node server.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:8787 --no-autoupdate",
    "deploy": "fly deploy --ha=false",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-status-bar": "58.0.3",
    "expo-web-browser": "58.0.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "simple-icons": "16.35.0",
    "typescript": "7.0.2"
  }
}
